# Mu Miami — environment template.
#
#   cp .env.example .env      then fill in real values (see below)
#
# .env is gitignored and MUST stay that way. Nothing in this file is a real credential.
# Compose does NOT auto-load a repo-root .env for this stack, because the compose
# project directory is deploy/all-in-one/ (the dir of the first -f file). Always pass
# it explicitly: `docker compose --env-file .env -f ... -f ...`, or use scripts/mm,
# which does it for you.

# --- Postgres -----------------------------------------------------------------------
# These set BOTH the Postgres superuser inside the database container and the
# DB_ADMIN_USER / DB_ADMIN_PW the OpenMU startup container connects with. They must match.
# Postgres has no host port mapping, so this never leaves the compose network — but it is
# still a credential, so generate a real one:
#   python3 -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(28)))"
#
# Leave POSTGRES_USER as `postgres`. The env override in OpenMU only rewrites connection
# strings that contain `User Id=postgres;`, so a different name silently does nothing.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_generate_a_random_28_char_string
POSTGRES_DB=openmu

# --- Advertised server address --------------------------------------------------------
# The address the connect server hands to clients so they know where the game servers are.
# NOT a bind address. If this is wrong, clients reach the connect server fine and then fail
# to reach any game server — which looks like "the server is down" but isn't.
#
# Set this to THIS MAC'S LAN IP. Then it works from this Mac and from the LAN both:
#   ipconfig getifaddr en0
#
# This is a DHCP lease, so it can move. `scripts/mm up` warns when this value no longer
# matches en0 — when it does, edit here and `scripts/mm restart`. A DHCP reservation on the
# router makes the problem go away permanently.
#
# Also accepted: `loopback` (127.127.127.127 — this Mac only, no LAN), `local` (DNS lookup
# of the container hostname — wrong inside Docker), `public` (WAN IP — routes from neither).
# See docs/runbook.md § 9 for the full tradeoff.
MM_RESOLVE_IP=192.168.1.10

# --- Admin panel --------------------------------------------------------------------
# Host port for the nginx-fronted admin panel. 8380 by default (upstream uses 80; this
# machine runs other dev servers). If 8380 collides, walk up: 8381, 8382, ...
# and update the port table in docs/runbook.md and CLAUDE.md when you do.
MM_ADMIN_PORT=8380

# The admin panel is behind nginx basic auth, backed by mumiami/.htpasswd (gitignored).
# The hash lives in that file, not here. These two are recorded for your own recall and
# are NOT read by compose:
#   scripts/mm htpasswd            # (re)generate mumiami/.htpasswd, prompts for password
#   htpasswd -B -c mumiami/.htpasswd admin      # equivalent by hand
MM_ADMIN_USER=admin
MM_ADMIN_PASSWORD=CHANGE_ME_whatever_you_typed_into_htpasswd
